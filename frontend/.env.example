# Copy to .env.local and fill in. .env.local is gitignored; this template is not.
#
# Every value here is a NEXT_PUBLIC_* var, so it is inlined into the client
# bundle at build time and is publicly visible. That is expected for Firebase
# web config — these identify the project, they do not authorize anything.
# Access control lives in Firebase Auth rules and the backend's token
# validation, never in the secrecy of these values.

# --- Firebase web app config -------------------------------------------------
# Firebase console -> Project settings -> General -> Your apps -> Web app -> SDK
# setup and configuration -> Config. Copy each field of the firebaseConfig object.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# --- Backend -----------------------------------------------------------------
# Origin of the ASP.NET Core API. Used for both REST calls and the SignalR hub
# URL (/hubs/board). Must match the backend's launch profile (http -> :5286,
# https -> :7169) and must be listed in the backend's Cors:FrontendOrigin from
# the other side. Optional — the app falls back to http://localhost:5286.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5286
